# Copy to .env.local. Never use NEXT_PUBLIC_ for API keys or webhook secrets.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
BILLING_APP_URL=http://localhost:43123
# Set true only after live verification, approved fees, and end-to-end testing.
PADDLE_LIVE_ENABLED=false

# Vercel disables CommonJS require() of ESM by default. Firebase Admin's
# jwks-rsa dependency needs this option on the deployed Node.js runtime.
# Register this in Vercel and redeploy; local Node 24 already supports it.
# NODE_OPTIONS=--experimental-require-module

# Firebase service account for server-side ID token verification and billing writes.
FIREBASE_ADMIN_PROJECT_ID=matchu-a1fbb
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public operator identity and customer support address for legal pages.
BILLING_OPERATOR_NAME=
BILLING_SUPPORT_EMAIL=

# Comma-separated Firebase uids that may hide or delete community posts.
COMMUNITY_OPERATOR_UIDS=
