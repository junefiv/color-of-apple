# Copy to .env.local. Never use NEXT_PUBLIC_ for API keys or webhook secrets.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
BILLING_APP_URL=http://localhost:43123
# Set true only after live verification, approved fees, and end-to-end testing.
PADDLE_LIVE_ENABLED=false

# Firebase service account for server-side ID token verification and billing writes.
FIREBASE_ADMIN_PROJECT_ID=matchu-a1fbb
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public operator identity and customer support address for legal pages.
BILLING_OPERATOR_NAME=
BILLING_SUPPORT_EMAIL=
