rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isPro(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.plan == "pro";
    }

    function validProfileCreate() {
      return request.resource.data.keys().hasOnly([
        "displayName", "email", "photoURL", "plan", "createdAt", "updatedAt"
      ])
        && request.resource.data.plan == "free"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "displayName", "email", "photoURL", "updatedAt"
      ])
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validProject() {
      return request.resource.data.keys().hasOnly([
        "title", "input", "selectedPaletteId", "overrides", "createdAt", "updatedAt"
      ])
        && request.resource.data.title is string
        && request.resource.data.input is map
        && request.resource.data.selectedPaletteId is string
        && request.resource.data.overrides is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function isFreeSlot(projectId) {
      return projectId == "slot-1"
        || projectId == "slot-2"
        || projectId == "slot-3"
        || projectId == "slot-4"
        || projectId == "slot-5";
    }

    function validCurrentWindow(slotId) {
      return request.resource.data.keys().hasOnly([
        "year", "month", "day", "slot", "generationCount", "exportCount", "updatedAt"
      ])
        && request.resource.data.year == request.time.year()
        && request.resource.data.month == request.time.month()
        && request.resource.data.day == request.time.day()
        && request.resource.data.slot == (request.time.hours() < 12 ? 0 : 12)
        && ((slotId == "0" && request.resource.data.slot == 0)
          || (slotId == "12" && request.resource.data.slot == 12))
        && request.resource.data.generationCount is int
        && request.resource.data.exportCount is int
        && request.resource.data.generationCount >= 0
        && request.resource.data.exportCount >= 0
        && request.resource.data.generationCount <= 5
        && request.resource.data.exportCount <= 5
        && request.resource.data.updatedAt == request.time;
    }

    function firstUseInWindow() {
      return (request.resource.data.generationCount == 1 && request.resource.data.exportCount == 0)
        || (request.resource.data.generationCount == 0 && request.resource.data.exportCount == 1);
    }

    function sameStoredWindow() {
      return resource.data.year == request.time.year()
        && resource.data.month == request.time.month()
        && resource.data.day == request.time.day()
        && resource.data.slot == (request.time.hours() < 12 ? 0 : 12);
    }

    function incrementsOneCounter() {
      return (request.resource.data.generationCount == resource.data.generationCount + 1
          && request.resource.data.exportCount == resource.data.exportCount)
        || (request.resource.data.generationCount == resource.data.generationCount
          && request.resource.data.exportCount == resource.data.exportCount + 1);
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfileCreate();
      allow update: if owns(uid) && validProfileUpdate();
      allow delete: if owns(uid);

      match /projects/{projectId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && (isPro(uid) || isFreeSlot(projectId))
          && validProject()
          && request.resource.data.createdAt == request.time;
        allow update: if owns(uid)
          && validProject()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(uid);
      }

      match /usage/{slotId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && validCurrentWindow(slotId) && firstUseInWindow();
        allow update: if owns(uid)
          && validCurrentWindow(slotId)
          && (sameStoredWindow() ? incrementsOneCounter() : firstUseInWindow());
        allow delete: if false;
      }
    }
  }
}
