rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isPro(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.plan == "pro";
    }

    function validProfileCreate() {
      return request.resource.data.keys().hasOnly([
        "displayName", "email", "photoURL", "plan", "createdAt", "updatedAt"
      ])
        && request.resource.data.plan == "free"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "displayName", "email", "photoURL", "updatedAt"
      ])
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validProject() {
      return request.resource.data.keys().hasOnly([
        "title", "input", "selectedPaletteId", "overrides", "tokenSnapshot", "colorHistory", "createdAt", "updatedAt"
      ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && request.resource.data.input is map
        && request.resource.data.selectedPaletteId is string
        && request.resource.data.overrides is map
        && request.resource.data.tokenSnapshot is map
        && request.resource.data.colorHistory is list
        && request.resource.data.colorHistory.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function isFreeSlot(projectId) {
      return projectId == "slot-1"
        || projectId == "slot-2"
        || projectId == "slot-3"
        || projectId == "slot-4"
        || projectId == "slot-5";
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfileCreate();
      allow update: if owns(uid) && validProfileUpdate();
      allow delete: if owns(uid);

      match /projects/{projectId} {
        allow read: if owns(uid);
        allow create: if owns(uid)
          && (isPro(uid) || isFreeSlot(projectId))
          && validProject()
          && request.resource.data.createdAt == request.time;
        allow update: if owns(uid)
          && validProject()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owns(uid);
      }
    }
  }
}
